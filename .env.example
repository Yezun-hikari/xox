# Public values only (Supabase "anon" key is designed to be public; security comes from RLS).
# NEVER put the service_role key here or anywhere in this repo.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Optional: other account page for loginUrl()/accountUrl() (default https://yezun.de/konto/), e.g. konto's dev server
# VITE_KONTO_URL=http://localhost:5174/konto/
